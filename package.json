{
  "name": "conventional-changelog-cmyr-config",
  "version": "3.0.0",
  "description": "草梅友仁使用的更新日志规范",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "templates"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "commit": "git-cz",
    "changelog": "cross-env DEBUG=conventional-changelog* conventional-changelog -i CHANGELOG.md -s -r 0 -n ./dist/index.mjs",
    "release": "semantic-release",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy-beta": "npm publish --tag beta",
    "deploy": "npm publish",
    "lint": "cross-env NODE_ENV=production eslint . --fix",
    "prepare": "husky install",
    "build": "cross-env NODE_ENV=production tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/conventional-changelog-cmyr-config.git"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog-cmyr"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint",
      "git add"
    ]
  },
  "keywords": [
    "conventional-changelog",
    "angular",
    "preset",
    "changelog",
    "emoji"
  ],
  "author": "CaoMeiYouRen <caomeiyouren@gmail.com>",
  "contributors": [
    "CaoMeiYouRen <caomeiyouren@gmail.com>",
    "Zeng Shunhao <shunhaozeng@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/conventional-changelog-cmyr-config/issues"
  },
  "homepage": "https://github.com/CaoMeiYouRen/conventional-changelog-cmyr-config#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/compare-func": "^1.3.3",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.3.0",
    "commitizen": "^4.3.1",
    "commitlint-config-cmyr": "1.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-writer-8": "npm:conventional-changelog-writer@^8.4.0",
    "conventional-changelog-writer-9": "npm:conventional-changelog-writer@^9.3.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog-cmyr": "2.0.0",
    "eslint": "^9.34.0",
    "eslint-config-cmyr": "2.0.0-beta.15",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "semantic-release": "^25.0.9",
    "semantic-release-cmyr-config": "1.0.0-beta.2",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "changelog": {
    "language": "zh"
  },
  "dependencies": {
    "compare-func": "^2.0.0",
    "debug": "^4.1.1",
    "handlebars": "^4.7.10"
  }
}
